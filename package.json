{
  "name": "autoparts-backend",
  "version": "1.0.0",
  "description": "AvtoEhtiyot marketplace backend (Express + MongoDB)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/seeds/seedCatalog.js && node src/seeds/seedVehicles.js",
    "seed:catalog": "node src/seeds/seedCatalog.js",
    "seed:vehicles": "node src/seeds/seedVehicles.js",
    "verify": "node verify.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.620.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "heic-convert": "^2.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.7.5",
    "uploadthing": "^7.7.4",
    "zod": "^3.23.8"
  }
